<head>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <form method="POST" action="/new">
    <h1>New Message</h1>

    <input
      type="text"
      id="messageUser"
      name="messageUser"
      placeholder="Your name"
    />

    <textarea
      id="message"
      name="messageText"
      placeholder="Write a message..."
    ></textarea>

    <button type="submit">Submit</button>
  </form>
</body>
