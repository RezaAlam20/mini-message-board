<head>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <h1>Mini Message Board</h1>

  <% rows.forEach((row) => { %>
    <div class="message">
      <div class="message-user"><%= row.username %></div>
      <p><%= row.message %></p>
    </div>
  <% }) %>

  <a href="/new">New message</a>
</body>