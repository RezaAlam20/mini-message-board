<head>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <h1>Mini Message Board</h1>

  <% messages.forEach((message) => { %>
    <div class="message">
      <div class="message-user"><%= message.user %></div>
      <p><%= message.text %></p>
      <div class="message-date">
        <%= message.added.toLocaleString() %>
      </div>
    </div>
  <% }) %>

  <a href="/new">New message</a>
</body>